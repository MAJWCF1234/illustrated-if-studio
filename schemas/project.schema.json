{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vn.studio/schemas/project.schema.json",
  "title": "Illustrated IF Studio Project",
  "type": "object",
  "required": ["formatVersion", "id", "title", "start", "story"],
  "properties": {
    "formatVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "start": { "type": "string", "minLength": 1 },
    "story": {
      "type": "object",
      "required": ["scenes"],
      "properties": {
        "scenes": { "type": "string", "default": "story/scenes.json" },
        "characters": { "type": "string" },
        "abilities": { "type": "string" },
        "scripts": { "type": "string" }
      }
    },
    "theme": { "type": "string", "default": "theme/theme.json" },
    "genre": { "type": "string" },
    "audio": {
      "type": "object",
      "description": "Optional project-level audio defaults (theme.audio preferred).",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "defaultBgm": { "type": ["string", "null"] },
        "channels": {
          "type": "object",
          "properties": {
            "bgm": {
              "type": "object",
              "properties": { "volume": { "type": "number", "minimum": 0, "maximum": 1 } },
              "additionalProperties": false
            },
            "sfx": {
              "type": "object",
              "properties": { "volume": { "type": "number", "minimum": 0, "maximum": 1 } },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "locales": {
      "type": "object",
      "description": "Optional localization tables — default scenes.json plus per-locale overlays.",
      "properties": {
        "default": { "type": "string", "minLength": 1 },
        "available": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "file": {
                "type": "string",
                "description": "Overlay JSON path relative to project root. Omit for the default locale."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "keepAbilitiesOnRestart": { "type": "boolean", "default": false },
        "layout": { "type": "string" },
        "formatLabel": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
