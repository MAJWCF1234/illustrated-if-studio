{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vn.studio/schemas/locale.schema.json",
  "title": "Illustrated IF Studio Locale Overlay",
  "type": "object",
  "required": ["id", "scenes"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "label": { "type": "string" },
    "scenes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "speaker": { "type": ["string", "null"] },
          "choices": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
