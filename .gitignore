# Dependencies
node_modules/
__pycache__/
.venv/

# Export + build output (regenerate with `npm run export:all`)
dist/
build/

# Machine-local studio state: active project, absolute export/import paths
studio-settings.json

# One-time "also set up sharing tools?" prompt markers
tools/.export-tools-offered
tools/.export-tools-ready

# Editor autosave backups — git is the history now
*.bak

# Stories are the author's content, not platform code, so everything under
# projects/ stays local — including projects set aside by an overwrite
# (projects/.replaced/). Only the sample that ships with the studio is tracked.
# The studio still finds local projects on disk; listProjects reads projects/.
projects/*
!projects/sample-project/
!projects/README.md

# Player save slots are runtime data; savesDir() recreates them on demand
projects/sample-project/saves/

# Launcher diagnostics written next to the studio on every start
tools/logs/

# Archives and packaged builds
*.zip

# OS / editor cruft
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.swp
